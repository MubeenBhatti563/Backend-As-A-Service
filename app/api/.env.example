# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baas_db?schema=public"

# Application Ports & URLs
PORT=3000
FRONTEND_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:4000,http://127.0.0.1:4000"

# Redis Credentials
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Session Configuration (SESSION_SECRET must be at least 32 characters in production)
SESSION_SECRET="your-at-least-32-characters-secure-random-session-secret"
# Cookie Flags for Cross-Origin Deployments ('lax' | 'strict' | 'none')
COOKIE_SAME_SITE="lax"
# Cookie Secure Flag ('true' | 'false' - forced to true if COOKIE_SAME_SITE is 'none' or in production)
COOKIE_SECURE="false"

# JWT Credentials
JWT_ACCESS_TOKEN_SECRET="your-jwt-access-token-secret"
JWT_REFRESH_TOKEN_SECRET="your-jwt-refresh-token-secret"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# Email Delivery (Resend)
RESEND_EMAIL_KEY="re_your_api_key_here"

# S3-compatible object storage (local development defaults to MinIO)
STORAGE_ENDPOINT="http://127.0.0.1:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="baas-objects"
STORAGE_ACCESS_KEY_ID="baasminio"
STORAGE_SECRET_ACCESS_KEY="baasminio-password"
