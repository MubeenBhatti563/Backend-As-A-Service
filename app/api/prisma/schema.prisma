generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PlatformUser {
  id                 String              @id @default(uuid())
  fullName           String              @map("full_name")
  email              String              @unique
  passwordHash       String              @map("password_hash")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  isVerified         Boolean             @default(false) @map("is_verified")
  sessions           Session[]
  verificationTokens VerificationToken[]
  projects           Project[]
  apiKeys            ApiKey[]

  @@map("platform_users")
}

model Project {
  id               String        @id @default(uuid())
  name             String        @db.VarChar(100)
  schemaName       String        @unique @map("schema_name") @db.VarChar(63)
  description      String?
  deploymentRegion String        @map("deployment_region")
  ownerId          String        @map("owner_id")
  status           ProjectStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  apiKeys ApiKey[]

  @@index([ownerId])
  @@map("projects")
}

model ApiKey {
  id         String        @id @default(uuid())
  projectId  String        @map("project_id")
  createdBy  String?       @map("created_by")
  name       String        @db.VarChar(50)
  keyHash    String        @unique @map("key_hash") @db.VarChar(255)
  keyPrefix  String        @map("key_prefix") @db.VarChar(30)
  role       ApiKeyRole
  status     ProjectStatus @default(ACTIVE)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?     @map("expires_at") @db.Timestamptz
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator PlatformUser? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, role])
  @@map("api_keys")
}

model Session {
  id     String       @id @default(uuid())
  userId String       @map("user_id")
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Device & Metadata tracking
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")
  deviceName String? @map("device_name")
  clientType String? @map("client_type")

  // Timestamps
  createdAt    DateTime @default(now()) @map("created_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  hashToken String    @unique @map("hash_token")
  type      TokenType @default(EMAIL_VERIFICATION) @map("type")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("verification_tokens")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  PENDING
}

enum ApiKeyRole {
  anon
  service
}
