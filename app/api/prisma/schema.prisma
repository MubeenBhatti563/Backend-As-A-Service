generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PlatformUser {
  id                 String              @id @default(uuid())
  fullName           String              @map("full_name")
  email              String              @unique
  passwordHash       String              @map("password_hash")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  isVerified         Boolean             @default(false) @map("is_verified")
  sessions           Session[]
  verificationTokens VerificationToken[]
  projects           Project[]
  apiKeys            ApiKey[]
  subscription       Subscription?
  activityLogs       ActivityLog[]

  @@map("platform_users")
}

model Project {
  id               String        @id @default(uuid())
  name             String        @db.VarChar(100)
  schemaName       String        @unique @map("schema_name") @db.VarChar(63)
  description      String?
  deploymentRegion String        @map("deployment_region")
  ownerId          String        @map("owner_id")
  status           ProjectStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  apiKeys       ApiKey[]
  projectUsages ProjectUsage[]
  activityLogs  ActivityLog[]

  @@index([ownerId])
  @@map("projects")
}

model ApiKey {
  id         String        @id @default(uuid())
  projectId  String        @map("project_id")
  createdBy  String?       @map("created_by")
  name       String        @db.VarChar(50)
  keyHash    String        @unique @map("key_hash") @db.VarChar(255)
  keyPrefix  String        @map("key_prefix") @db.VarChar(30)
  role       ApiKeyRole
  status     ProjectStatus @default(ACTIVE)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?     @map("expires_at") @db.Timestamptz
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator PlatformUser? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, role])
  @@map("api_keys")
}

model Session {
  id     String       @id @default(uuid())
  userId String       @map("user_id")
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Device & Metadata tracking
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")
  deviceName String? @map("device_name")
  clientType String? @map("client_type")

  // Timestamps
  createdAt    DateTime @default(now()) @map("created_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  hashToken String    @unique @map("hash_token")
  type      TokenType @default(EMAIL_VERIFICATION) @map("type")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("verification_tokens")
}

model Plan {
  id          String   @id @default(uuid())
  code        PlanCode @unique
  name        String   @db.VarChar(50)
  description String?
  priceCents  Int?     @map("price_cents") // null = custom pricing (Enterprise)
  currency    String   @default("USD") @db.VarChar(3)
  isAvailable Boolean  @default(true) @map("is_available")

  // Limits. null = unlimited / custom.
  maxProjects            Int?    @map("max_projects")
  maxRealtimeConnections Int?    @map("max_realtime_connections")
  apiRequestsMonthly     BigInt? @map("api_requests_monthly")
  dbStorageBytes         BigInt? @map("db_storage_bytes")
  fileStorageBytes       BigInt? @map("file_storage_bytes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan         @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("subscriptions")
}

// One row per project per billing period.
// Project table (Database / Files columns): current period row.
// Usage meters: SUM across the user's projects vs the Plan limits.
model ProjectUsage {
  id                String   @id @default(uuid())
  projectId         String   @map("project_id")
  periodStart       DateTime @map("period_start") @db.Timestamptz
  periodEnd         DateTime @map("period_end") @db.Timestamptz
  dbBytes           BigInt   @default(0) @map("db_bytes")
  fileBytes         BigInt   @default(0) @map("file_bytes")
  apiRequests       BigInt   @default(0) @map("api_requests")
  peakRealtimeConns Int      @default(0) @map("peak_realtime_connections")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, periodStart])
  @@index([periodStart])
  @@map("project_usage")
}

// "Recent activity" feed. projectName is a snapshot so entries survive project deletion.
model ActivityLog {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  projectId   String?      @map("project_id")
  projectName String?      @map("project_name") @db.VarChar(100)
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user    PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
  @@map("activity_logs")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  PENDING
}

enum ApiKeyRole {
  anon
  service
}

enum PlanCode {
  HOBBY
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_PAUSED
  PROJECT_RESUMED
  API_KEY_CREATED
  API_KEY_REVOKED
}
