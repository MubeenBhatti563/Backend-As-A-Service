generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PlatformUser {
  id                 String              @id @default(uuid())
  fullName           String              @map("full_name")
  email              String              @unique
  passwordHash       String              @map("password_hash")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  isVerified         Boolean             @default(false) @map("is_verified")
  sessions           Session[]
  verificationTokens VerificationToken[]

  @@map("platform_users")
}

model Session {
  id     String       @id @default(uuid())
  userId String       @map("user_id")
  user   PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Device & Metadata tracking
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")
  deviceName String? @map("device_name")
  clientType String? @map("client_type")

  // Timestamps
  createdAt    DateTime @default(now()) @map("created_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  hashToken String    @unique @map("hash_token")
  type      TokenType @default(EMAIL_VERIFICATION) @map("type")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hashToken, type])
  @@map("verification_tokens")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
