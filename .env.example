# ========================================================
# BaaS Monorepo Environment Configuration (.env.example)
# ========================================================

# --------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# --------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=baas_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baas_db?schema=public

# --------------------------------------------------------
# 2. Redis Configuration
# --------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Local MinIO credentials (development only; change for shared/production use)
MINIO_ROOT_USER=baasminio
MINIO_ROOT_PASSWORD=baasminio-password

# --------------------------------------------------------
# 3. Session & Security Configuration
# --------------------------------------------------------
# SESSION_SECRET must be at least 32 characters in production
SESSION_SECRET=your-at-least-32-characters-secure-random-session-secret
# Cookie SameSite mode ('lax' | 'strict' | 'none')
COOKIE_SAME_SITE=lax
# Cookie Secure flag ('true' | 'false' - forced to true when COOKIE_SAME_SITE=none or in production)
COOKIE_SECURE=false

# --------------------------------------------------------
# 4. JWT & Auth Tokens
# --------------------------------------------------------
JWT_ACCESS_TOKEN_SECRET=your-jwt-access-token-secret
JWT_REFRESH_TOKEN_SECRET=your-jwt-refresh-token-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------------------
# 5. Email Delivery (Resend API)
# --------------------------------------------------------
RESEND_EMAIL_KEY=re_your_api_key_here

# --------------------------------------------------------
# 6. API Service (apps/api)
# --------------------------------------------------------
PORT=3000
FRONTEND_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
# Used by Docker Compose; local API processes should use 127.0.0.1:9000.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=baas-objects
STORAGE_ACCESS_KEY_ID=baasminio
STORAGE_SECRET_ACCESS_KEY=baasminio-password

# --------------------------------------------------------
# 7. Web Application (apps/web)
# --------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_ENABLE_MOCKS=false
